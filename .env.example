# Copy into your local .env file. Never commit actual secrets.

# Supabase public/client configuration
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# AI: Gemini direct is preferred; get a key from Google AI Studio.
# Keep this server-only. Do not add a VITE_ prefix.
GEMINI_API_KEY="your-gemini-api-key"

# Optional alternative: Lovable AI Gateway key, used if GEMINI_API_KEY is unset.
LOVABLE_API_KEY="your-lovable-api-key"

# Optional privileged Supabase server key. Keep server-only.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PayFast server credentials
PAYFAST_MERCHANT_ID="your-payfast-merchant-id"
PAYFAST_MERCHANT_KEY="your-payfast-merchant-key"
PAYFAST_PASSPHRASE="your-payfast-passphrase"
